{
  "args": [
    "-p",
    "<execution-context>\nexecution_path=metaharness-driven\ninner_harness=claude\nworkspace=metaharness-scratch\nhermetic=strict\nconfinement=inner-harness\nsubstrate=not-used-by-metaharness\ndecision_mode=frame\nimplication=metaharness applies the sealed frame before each mediated call\n</execution-context>\n\nstate the workflow you are in",
    "--output-format",
    "stream-json",
    "--verbose",
    "--strict-mcp-config",
    "--setting-sources",
    "",
    "--settings",
    "/scratch/run-1/claude-settings.json",
    "--model",
    "a-model",
    "--max-turns",
    "8",
    "--tools",
    "Task,Bash,CronCreate,CronDelete,CronList,Edit,EnterWorktree,ExitWorktree,ListAgents,NotebookEdit,Read,ReportFindings,ScheduleWakeup,SendMessage,Skill,TaskStop,ToolSearch,WebFetch,WebSearch,Workflow,Write,Glob,Grep"
  ],
  "env": {
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CONFIG_DIR": "/scratch/run-1/claude-home",
    "HOME": "/operator",
    "LANG": "C.UTF-8",
    "PATH": "/operator/.local/bin:/usr/local/bin:/usr/bin:/bin",
    "TERM": "dumb",
    "TMPDIR": "/scratch/run-1/tmp",
    "USER": "operator"
  },
  "program": "claude"
}
